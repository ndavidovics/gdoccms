APP_NAME="MutualOffline"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mutual_offline
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=localhost
SESSION_SECURE_COOKIE=false

REVERB_APP_ID=mutualoffline
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Signed-URL key for QR join tokens (HMAC-SHA256). Rotate to invalidate outstanding QRs.
JOIN_TOKEN_SECRET=change-me-in-production
JOIN_TOKEN_TTL_SECONDS=300

# Heartbeat watchdog
HEARTBEAT_TIMEOUT_SECONDS=45
HEARTBEAT_INTERVAL_SECONDS=10

# Salt prefix used when comparing client-uploaded contact hashes (defense-in-depth).
CONTACT_HASH_PEPPER=change-me-in-production
